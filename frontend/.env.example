# Only needed when running the frontend standalone (pnpm dev) outside Docker.
# In the Docker stack these come from the root .env via docker-compose.

# Public site URL (used by sitemap.ts / robots.ts)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The backend, for server-side (SSR/RSC) calls and for the /api rewrite of
# pnpm dev. The browser never calls it directly: it uses /api on its own origin.
API_URL=http://localhost:8000
