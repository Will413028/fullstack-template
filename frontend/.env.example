# For pnpm dev on the host (make dev runs the backend, not the frontend).
# On Vercel set the same names in the project's environment variables
# (docs/deploy-vps.md).

# Public site URL: sitemap.ts / robots.ts, and server-side (SSR/RSC) API calls,
# which go to its /api like the browser's.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# The backend, for the /api rewrite of pnpm dev only. On Vercel, /api goes to
# API_ORIGIN through frontend/vercel.json instead.
API_URL=http://localhost:8000
