{
  "name": "template-go-nextjs-frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.14.0",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit && biome check --error-on-warnings .",
    "format": "biome format --write",
    "gen:api": "make -s -C .. bin/buf && ../bin/buf generate",
    "gen:api:check": "pnpm gen:api && git diff --exit-code --stat -- src/generated && test -z \"$(git ls-files --others --exclude-standard -- src/generated)\" || { echo 'src/generated is stale: run pnpm gen:api and commit it'; exit 1; }",
    "check:deps": "knip",
    "check:arch": "depcruise src --config .dependency-cruiser.cjs",
    "test": "vitest run",
    "test:report": "vitest run --reporter=default --reporter=json --outputFile.json=test-report.json",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 || exit 0; lefthook install || echo 'warning: lefthook install failed, git hooks are not active' >&2"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-query": "2.3.1",
    "@connectrpc/connect-web": "2.3.0",
    "@hookform/resolvers": "^6.0.1",
    "@tanstack/react-query": "^5.105.0",
    "@tanstack/react-query-devtools": "^5.105.0",
    "clsx": "^2.1.1",
    "lucide-react": "^1.62.0",
    "next": "^16.4.3",
    "next-intl": "^4.14.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.91.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "dependency-cruiser": "18.7.0",
    "jsdom": "^30.1.3",
    "knip": "~6.43.0",
    "lefthook": "^2.2.2",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
