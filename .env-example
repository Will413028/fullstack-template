# Copied to .env by `make init-env`, which also creates the password files under .secrets/.
# Passwords never go in this file: compose mounts .secrets/* as secrets and services read them via <KEY>_FILE.

# PostgreSQL: the superuser initializes the volume; migrate uses the owner role, the backend the app role
# (deploy/postgres/initdb/10-roles.sh). Roles are created only when the volume is first initialized.
POSTGRES_USER=postgres
POSTGRES_DB=fullstack
DB_OWNER_USER=fullstack_owner
DB_APP_USER=fullstack_app

# Backend
# MODE: dev (text logs) or prod (JSON logs)
MODE=dev
# Session lifetime (Go durations); SESSION_IDLE must not exceed SESSION_ABSOLUTE
SESSION_ABSOLUTE=168h
SESSION_IDLE=24h
# COOKIE_SECURE MUST be true in production (requires HTTPS); false for local http
COOKIE_SECURE=false
# Comma-separated CIDRs allowed to set X-Forwarded-For / X-Request-ID; empty trusts none
TRUSTED_PROXIES=
# DB_MAX_CONNS=20
# DB_STATEMENT_TIMEOUT=5s
# AUTH_RATE_LIMIT_PER_MIN=5
# PASSWORD_HIBP_CHECK=false

# Frontend
# NEXT_PUBLIC_API_URL is the browser-facing backend URL, inlined at build time.
# Change it for prod and rebuild (make build), not just restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
