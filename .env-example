# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=fullstack

# Backend
# MODE: dev (text logs) or prod (JSON logs)
MODE=dev
# sslmode=disable: the compose Postgres has no TLS, and Atlas (lib/pq) defaults to sslmode=require
DATABASE_URL=postgres://postgres:changeme@postgres:5432/fullstack?sslmode=disable
# Session lifetime (Go durations); SESSION_IDLE must not exceed SESSION_ABSOLUTE
SESSION_ABSOLUTE=168h
SESSION_IDLE=24h
# COOKIE_SECURE MUST be true in production (requires HTTPS); false for local http
COOKIE_SECURE=false
# Comma-separated CIDRs allowed to set X-Forwarded-For / X-Request-ID; empty trusts none
TRUSTED_PROXIES=
# DB_MAX_CONNS=20
# DB_STATEMENT_TIMEOUT=5s
# AUTH_RATE_LIMIT_PER_MIN=5
# PASSWORD_HIBP_CHECK=false

# Frontend
# NEXT_PUBLIC_API_URL is the browser-facing backend URL, inlined at build time.
# Change it for prod and rebuild (make build), not just restart.
NEXT_PUBLIC_API_URL=http://localhost:8000
