# For running the backend standalone (make run) outside Docker.
# The Docker stack uses the root .env instead; the variables are the same.

MODE=dev
DATABASE_URL=postgres://postgres:changeme@localhost:5432/fullstack?sslmode=disable
SESSION_ABSOLUTE=168h
SESSION_IDLE=24h
# false for local http; MUST be true in production (HTTPS)
COOKIE_SECURE=false
TRUSTED_PROXIES=
