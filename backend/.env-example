# For running the backend standalone (make run) outside Docker; the Docker stack is configured in the root
# .env-example and docker-compose.yml. Any variable KEY can instead be KEY_FILE, a file holding the value.

MODE=dev
# connects as the app role; the password is not part of the URL. Needs a reachable PostgreSQL set up by
# deploy/postgres/initdb (the compose postgres does not publish 5432); the file is the one `make init-env` creates.
DATABASE_URL=postgres://fullstack_app@localhost:5432/fullstack?sslmode=disable
DATABASE_PASSWORD_FILE=../.secrets/db_app_password
SESSION_ABSOLUTE=168h
SESSION_IDLE=24h
# false for local http; MUST be true in production (HTTPS)
COOKIE_SECURE=false
TRUSTED_PROXIES=
